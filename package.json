{
  "name": "fribbels-e7-optimizer",
  "productName": "Fribbels E7 Optimizer",
  "private": true,
  "author": {
    "name": "Fribbels"
  },
  "version": "1.0.0",
  "description": "Epic 7 gear optimizer — Electron shell + Vite/React UI",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "yarn build:main && yarn build:ui",
    "build:main": "vite build --config app/main/vite.config.mts",
    "build:ui": "vite build --config app/ui/vite.config.mts",
    "start": "yarn build && electron ./app",
    "typecheck": "tsc -p app/main && tsc -p app/ui",
    "package": "yarn build && electron-builder build --publish never",
    "package-all": "yarn build && electron-builder build -mwl",
    "package-ci": "yarn build && electron-builder --publish always",
    "package-mac": "yarn build && electron-builder build --mac",
    "package-linux": "yarn build && electron-builder build --linux",
    "package-win": "yarn build && electron-builder build --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "productName": "FribbelsE7Optimizer",
    "appId": "fribbelse7optimizer",
    "files": [
      "node_modules/",
      "app.html",
      "main.prod.js",
      "ui-dist/",
      "ui-loader.js",
      "css/",
      "assets/",
      "js/",
      "locales/",
      "package.json",
      "!ui-dist/*.map"
    ],
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "extraResources": [
      "./resources/**"
    ],
    "extraFiles": [
      "./data/**",
      "./app/locales/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "fribbels",
      "repo": "Fribbels-Epic-7-Optimizer",
      "private": false
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "45.2.2",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
